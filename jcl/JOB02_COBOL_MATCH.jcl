//HRBSJ02  JOB (ACCT),'HRBS COBOL MATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ASSIGNMENT 2 : COMPILE + LINK + RUN HRBSMTCH
//* NOTE: IGYWCL IS THE COBOL COMPILE-AND-LINK PROC ON MOST SYSTEMS.
//*       IF YOUR SITE USES ANOTHER NAME (ASK YOUR ADMIN) CHANGE IT.
//* COPY cobol/HRBSMTCH.cbl INTO MEMBER HRBSMTCH OF &SYSUID..HRBS.COBOL
//*--------------------------------------------------------------------
//COMPILE  EXEC IGYWCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..HRBS.COBOL(HRBSMTCH)
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD(HRBSMTCH)
//*
//DEL      EXEC PGM=IEFBR14
//OLD      DD DSN=&SYSUID..HRBS.FILE3,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*
//RUN      EXEC PGM=HRBSMTCH,COND=(4,LT,COMPILE.COBOL)
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD
//FILE1    DD DISP=SHR,DSN=&SYSUID..HRBS.FILE1
//FILE2    DD DISP=SHR,DSN=&SYSUID..HRBS.FILE2
//FILE3    DD DSN=&SYSUID..HRBS.FILE3,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=160,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
