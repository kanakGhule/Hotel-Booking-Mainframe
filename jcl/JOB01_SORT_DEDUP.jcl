//HRBSJ01  JOB (ACCT),'HRBS DEDUP SORT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* SORT RESERVATIONS AND REMOVE DUPLICATES
//SORT1    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..HRBS.RESERV.INPUT,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..HRBS.RESERV.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(13,8,CH,A)
  SUM FIELDS=NONE
/*