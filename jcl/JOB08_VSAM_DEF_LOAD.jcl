//HRBSJ08  JOB (ACCT),'HRBS VSAM KSDS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* DEFINE VSAM KSDS CLUSTER AND REPRO VALIDATED RESERVATION RECORDS
//* CLUSTER: &SYSUID..HRBS.RESERV.KSDS
//* KEY    : 8 BYTES AT OFFSET 12 (COLS 13-20, RESERVATION ID)
//* RECLEN : 80 BYTES FIXED (RECORDSIZE 80 80)
//* INPUT  : &SYSUID..HRBS.RESERV.VALID
//*--------------------------------------------------------------------
//IDCAMS01 EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE &SYSUID..HRBS.RESERV.KSDS CLUSTER PURGE
  SET MAXCC = 0

  DEFINE CLUSTER (NAME(&SYSUID..HRBS.RESERV.KSDS) -
         INDEXED -
         KEYS(8 12) -
         RECORDSIZE(80 80) -
         TRACKS(5 5) -
         FREESPACE(10 10) -
         SHAREOPTIONS(2 3)) -
    DATA  (NAME(&SYSUID..HRBS.RESERV.KSDS.DATA)) -
    INDEX (NAME(&SYSUID..HRBS.RESERV.KSDS.INDEX))

  IF LASTCC = 0 THEN -
    REPRO INDATASET(&SYSUID..HRBS.RESERV.VALID) -
          OUTDATASET(&SYSUID..HRBS.RESERV.KSDS)

  IF LASTCC = 0 THEN -
    PRINT INDATASET(&SYSUID..HRBS.RESERV.KSDS) COUNT(5) CHAR
/*
