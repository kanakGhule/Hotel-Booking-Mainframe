//HRBSJ05  JOB (ACCT),'HRBS DB2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* RUNS db2/SCHEMA.sql (OR QUERIES.sql) THROUGH DSNTEP2.
//* THE ITEMS BELOW MARKED <...> ARE SITE-SPECIFIC - ASK YOUR ADMIN:
//*   DB2 SUBSYSTEM NAME, DSNTEP2 PLAN NAME, SDSNLOAD / RUNLIB DSNs.
//* COPY THE .sql FILE INTO MEMBER SCHEMA OF &SYSUID..HRBS.SQL (FB 80)
//*--------------------------------------------------------------------
//DB2RUN   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=<DB2.SDSNLOAD>
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=&SYSUID..HRBS.SQL(SCHEMA)
//SYSTSIN  DD *
  DSN SYSTEM(<DB2SSID>)
  RUN PROGRAM(DSNTEP2) PLAN(<DSNTEP2PLAN>) LIB('<DB2.RUNLIB.LOAD>')
  END
/*
