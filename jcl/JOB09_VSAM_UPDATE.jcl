//HRBSJ09  JOB (ACCT),'HRBS VSAM UPDATE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILE, LINK-EDIT AND EXECUTE HRBSUPD (VSAM TRANSACTION ENGINE)
//* MASTER : &SYSUID..HRBS.RESERV.KSDS (VSAM KSDS, I-O)
//* INPUT  : &SYSUID..HRBS.TRANS.INPUT (80-BYTE TRANSACTIONS)
//* AUDIT  : &SYSUID..HRBS.TRANS.AUDIT (120-BYTE AUDIT TRAIL)
//* REJECT : &SYSUID..HRBS.TRANS.REJECT (120-BYTE REJECTED TRANS)
//* RETURN CODES: CC 0000 (ALL OK), CC 0004 (REJECTS DETECTED)
//*--------------------------------------------------------------------
//COMPILE  EXEC IGYWCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..HRBS.COBOL(HRBSUPD)
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD(HRBSUPD)
//*
//DEL      EXEC PGM=IEFBR14
//OLDAUD   DD DSN=&SYSUID..HRBS.TRANS.AUDIT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//OLDREJ   DD DSN=&SYSUID..HRBS.TRANS.REJECT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*
//RUN      EXEC PGM=HRBSUPD,COND=(4,LT,COMPILE.COBOL)
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD
//KSDSDD   DD DISP=SHR,DSN=&SYSUID..HRBS.RESERV.KSDS
//TRNIN    DD DISP=SHR,DSN=&SYSUID..HRBS.TRANS.INPUT
//AUDOUT   DD DSN=&SYSUID..HRBS.TRANS.AUDIT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//REJOUT   DD DSN=&SYSUID..HRBS.TRANS.REJECT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
