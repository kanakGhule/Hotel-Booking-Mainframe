//HRBSJ06  JOB (ACCT),'HRBS BILLING',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILE, LINK-EDIT AND EXECUTE HRBSBIL BILLING ENGINE
//* INPUT  : &SYSUID..HRBS.RESERV.SORTED (OR .VALID) (LRECL 80)
//* OPTION : &SYSUID..HRBS.SERVICE.INPUT (EXTRA SERVICES, LRECL 80)
//* OUTPUT : &SYSUID..HRBS.INVOICE.OUTPUT (100-BYTE INVOICE FILE)
//*--------------------------------------------------------------------
//COMPILE  EXEC IGYWCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..HRBS.COBOL(HRBSBIL)
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD(HRBSBIL)
//*
//DEL      EXEC PGM=IEFBR14
//OLD      DD DSN=&SYSUID..HRBS.INVOICE.OUTPUT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*
//RUN      EXEC PGM=HRBSBIL,COND=(4,LT,COMPILE.COBOL)
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD
//RESVIN   DD DISP=SHR,DSN=&SYSUID..HRBS.RESERV.SORTED
//SRVFILE  DD DISP=SHR,DSN=&SYSUID..HRBS.SERVICE.INPUT
//INVOUT   DD DSN=&SYSUID..HRBS.INVOICE.OUTPUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
