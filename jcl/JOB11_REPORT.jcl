//HRBSJ11  JOB (ACCT),'HRBS REPORT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILE, PREPARE DATA AND EXECUTE HRBSRPT (BILLING REPORT)
//* STEP 1: COMPILE AND LINK-EDIT COBOL PROGRAM HRBSRPT
//* STEP 2: DFSORT SORTS INVOICES BY INVOICE ID (COLS 25-32)
//* STEP 3: RUN HRBSRPT TO GENERATE 132-COLUMN PRINTED REPORT
//* OUTPUT : &SYSUID..HRBS.BILLING.REPORT (LRECL 132)
//*--------------------------------------------------------------------
//COMPILE  EXEC IGYWCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..HRBS.COBOL(HRBSRPT)
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD(HRBSRPT)
//*
//DEL      EXEC PGM=IEFBR14
//OLDRPT   DD DSN=&SYSUID..HRBS.BILLING.REPORT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*
//SORTINV  EXEC PGM=SORT,COND=(4,LT,COMPILE.COBOL)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=&SYSUID..HRBS.INVOICE.OUTPUT
//SORTOUT  DD DSN=&&SRTINV,DISP=(NEW,PASS),SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(25,8,CH,A)
/*
//*
//RUN      EXEC PGM=HRBSRPT,COND=(4,LT,SORTINV)
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD
//INFILE   DD DSN=&&SRTINV,DISP=(OLD,DELETE)
//RPTFILE  DD DSN=&SYSUID..HRBS.BILLING.REPORT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
