//HRBSJ07  JOB (ACCT),'HRBS VALIDATE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILE, LINK-EDIT AND RUN HRBSVAL (RESERVATION VALIDATOR)
//* INPUT  : &SYSUID..HRBS.RESERV.SORTED (LRECL 80)
//* OUTPUT : &SYSUID..HRBS.RESERV.VALID  (LRECL 80)
//* REJECT : &SYSUID..HRBS.RESERV.REJECT (LRECL 120)
//* RETURN CODES: CC 0000 (0 REJECTS), CC 0004 (REJECTS FOUND)
//*--------------------------------------------------------------------
//COMPILE  EXEC IGYWCL
//COBOL.SYSIN  DD DISP=SHR,DSN=&SYSUID..HRBS.COBOL(HRBSVAL)
//LKED.SYSLMOD DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD(HRBSVAL)
//*
//DEL      EXEC PGM=IEFBR14
//OLDVAL   DD DSN=&SYSUID..HRBS.RESERV.VALID,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//OLDREJ   DD DSN=&SYSUID..HRBS.RESERV.REJECT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*
//RUN      EXEC PGM=HRBSVAL,COND=(4,LT,COMPILE.COBOL)
//STEPLIB  DD DISP=SHR,DSN=&SYSUID..HRBS.LOAD
//RESVIN   DD DISP=SHR,DSN=&SYSUID..HRBS.RESERV.SORTED
//VALOUT   DD DSN=&SYSUID..HRBS.RESERV.VALID,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//REJOUT   DD DSN=&SYSUID..HRBS.RESERV.REJECT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
