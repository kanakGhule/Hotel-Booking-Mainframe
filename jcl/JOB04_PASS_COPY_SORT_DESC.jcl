//HRBSJ04P JOB (ACCT),'HRBS A4 PASS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ASSIGNMENT 4 - SCENARIO 1 (SUCCESS)
//*  1 COUNT RECORDS BEFORE SORT      4 COMPARE THE TWO COUNTS
//*  2 COPY + SORT DESCENDING (TEMP)  5 COUNTS EQUAL   -> KEEP OUTPUT
//*  3 COUNT RECORDS AFTER SORT       6 COUNTS DIFFER  -> ERROR MESSAGE
//* INPUT = 100 RECORD RESERVATION FILE (PS). OUTPUT CATALOGED ONLY
//* WHEN THE COUNTS MATCH.
//*--------------------------------------------------------------------
//DEL      EXEC PGM=IEFBR14
//OLD      DD DSN=&SYSUID..HRBS.A4.OUTPUT,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//*---- STEP 1 : COUNT BEFORE SORT -------------------------------------
//CNTBEF   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=&SYSUID..HRBS.A4.INPUT
//SORTOUT  DD DSN=&&CNTBEF,DISP=(NEW,PASS),SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  OPTION COPY
  OUTFIL REMOVECC,NODETAIL,
    TRAILER1=(COUNT=(M11,LENGTH=8),72X)
/*
//*---- STEP 2 : SORT DESCENDING INTO TEMPORARY DATASET -----------------
//SORTDESC EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=&SYSUID..HRBS.A4.INPUT
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(13,8,CH,D)
/*
//*---- STEP 3 : COUNT AFTER SORT ---------------------------------------
//CNTAFT   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&&SORTED,DISP=(OLD,PASS)
//SORTOUT  DD DSN=&&CNTAFT,DISP=(NEW,PASS),SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  OPTION COPY
  OUTFIL REMOVECC,NODETAIL,
    TRAILER1=(COUNT=(M11,LENGTH=8),72X)
/*
//*---- STEP 4 : COMPARE -----------------------------------------------
//* TWO COUNT RECORDS ARE MERGED AND DUPLICATES DROPPED:
//*   SAME COUNT -> 1 RECORD LEFT ; DIFFERENT COUNT -> 2 RECORDS LEFT.
//* ICETOOL SETS RC=4 WHEN THE RECORD COUNT IS NOT EXACTLY 1.
//MERGECNT EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&&CNTBEF,DISP=(OLD,DELETE)
//         DD DSN=&&CNTAFT,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&&CMP,DISP=(NEW,PASS),SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,8,CH,A)
  SUM FIELDS=NONE
/*
//CHECK    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//CMP      DD DSN=&&CMP,DISP=(OLD,DELETE)
//TOOLIN   DD *
  COUNT FROM(CMP) NOTEQUAL(1) RC4
/*
//*---- STEPS 5/6 : KEEP OUTPUT OR PRINT ERROR --------------------------
//CHKRC    IF (CHECK.RC = 0) THEN
//KEEP     EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&SYSUID..HRBS.A4.OUTPUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  OPTION COPY
/*
//OKMSG    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD *
**** RECORD COUNT BEFORE = AFTER SORT. OUTPUT FILE KEPT. ****
/*
//SYSUT2   DD SYSOUT=*
//         ELSE
//ERRMSG   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD *
**** ERROR: RECORD COUNT MISMATCH AFTER SORT. OUTPUT NOT KEPT. ****
/*
//SYSUT2   DD SYSOUT=*
//FAILRC   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC=8
/*
//         ENDIF
