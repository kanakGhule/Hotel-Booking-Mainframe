//HRBSJ03  JOB (ACCT),'HRBS REXX',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ASSIGNMENT 3 : RUN REXX HRBSDEDP IN BATCH
//* COPY rexx/HRBSDEDP.rexx INTO MEMBER HRBSDEDP OF &SYSUID..HRBS.REXX
//* INPUT : 120 RECORDS X 100 BYTES   OUTPUT : 105 UNIQUE, SORTED
//*--------------------------------------------------------------------
//DEL      EXEC PGM=IEFBR14
//OLD      DD DSN=&SYSUID..HRBS.INVOICE.CLEAN,
//            DISP=(MOD,DELETE),SPACE=(TRK,1)
//REXXRUN  EXEC PGM=IKJEFT01,DYNAMNBR=50
//SYSEXEC  DD DISP=SHR,DSN=&SYSUID..HRBS.REXX
//SYSTSPRT DD SYSOUT=*
//INDD     DD DISP=SHR,DSN=&SYSUID..HRBS.INVOICE.INPUT
//OUTDD    DD DSN=&SYSUID..HRBS.INVOICE.CLEAN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSTSIN  DD *
  %HRBSDEDP
/*
